{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sentry Drive Tauri",
  "version": "../package.json",
  "identifier": "com.sentrysix.sentrydrive.tauripreview",
  "build": {
    "beforeBuildCommand": "node scripts/tauri/prepare-frontend.mjs",
    "beforeDevCommand": "node scripts/tauri/prepare-frontend.mjs",
    "frontendDist": "../tauri-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob: https://tiles.sentryusb.com",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://tiles.sentryusb.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../changelog.json": "changelog.json",
      "../assets/tesla-superchargers.json": "assets/tesla-superchargers.json"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
