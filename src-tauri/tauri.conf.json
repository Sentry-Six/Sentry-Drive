{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sentry Drive",
  "mainBinaryName": "Sentry Drive",
  "version": "../package.json",
  "identifier": "com.jefffromtheirs.sentry-drive",
  "build": {
    "beforeBuildCommand": "node scripts/tauri/prepare-frontend.mjs",
    "beforeDevCommand": "node scripts/tauri/prepare-frontend.mjs",
    "frontendDist": "../tauri-dist",
    "beforeBundleCommand": "node scripts/tauri/squirrel-shim.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob: https://tiles.sentryusb.com",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://tiles.sentryusb.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../changelog.json": "changelog.json",
      "../assets/tesla-superchargers.json": "assets/tesla-superchargers.json"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "frameworks": [
        "target/squirrel-shim/Squirrel.framework"
      ]
    },
    "createUpdaterArtifacts": false,
    "publisher": "Sentry-Six",
    "copyright": "Sentry-Six",
    "shortDescription": "Tesla dashcam drives viewer",
    "longDescription": "Standalone Tesla dashcam drives processor - replicates Sentry USB drives processing",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
