{
  "name": "sentry-drive",
  "version": "1.4.2",
  "type": "module",
  "description": "Standalone Tesla dashcam drives processor - replicates Sentry USB drives processing",
  "main": "src/main/electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "process": "node src/processing/process.js",
    "test": "node --test src/shared/drive-calc.test.js src/shared/atomic-write.test.js src/shared/clip-path.test.js src/shared/event-gap-fill.test.js src/processing/grouper.test.js src/main/drive-data-reader.test.js src/main/drive-index.test.js src/main/disk-drive-grouper.test.js src/main/drive-loader-service.test.js src/main/drive-loader-client.test.js src/renderer/drive-page-model.test.js src/renderer/replay-bearing.test.js",
    "prebuild": "npm test",
    "build": "electron-builder --win",
    "publish": "npm test && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.jefffromtheirs.sentry-drive",
    "productName": "Sentry Drive",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "changelog.json"
    ],
    "asarUnpack": [
      "src/processing/**",
      "src/shared/**",
      "src/main/drive-data-reader.cjs",
      "node_modules/stream-json/**",
      "node_modules/stream-chain/**"
    ],
    "artifactName": "Sentry-Drive-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon/sentrydrive.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "Sentry-Drive-${version}-${arch}.${ext}",
      "icon": "assets/app-icon/sentrydrive.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "JeffFromTheIRS <155955500+JeffFromTheIRS@users.noreply.github.com>",
      "category": "Utility",
      "artifactName": "Sentry-Drive-${version}.${ext}",
      "icon": "assets/app-icon/sentrydrive.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "Sentry-Six",
      "repo": "Sentry-Drive"
    }
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "stream-chain": "^4.2.5",
    "stream-json": "^3.5.0"
  }
}
